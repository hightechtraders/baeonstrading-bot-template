{
    "brand_name": "Traderscore",
    "brand_domain": "baeonstrading-bot-template.vercel.app",
    "brand_hostname": {
        "staging": "baeonstrading-bot-template.vercel.app",
        "production": "baeonstrading-bot-template.vercel.app"
    },
    "domain_name": "baeonstrading-bot-template.vercel.app",
    "colors": {
        "primary": "#00f0ff",
        "secondary": "#64748b",
        "tertiary": "#7000ff",
        "success": "#00ff9d",
        "danger": "#ff3366",
        "warning": "#ffb800",
        "info": "#00b8ff",
        "neutral": "#94a3b8",
        "black": "#030712",
        "white": "#ffffff",
        "grey": {
            "50": "#0b0f19",
            "100": "#131b2e",
            "200": "#334155",
            "300": "#475569",
            "400": "#64748b",
            "500": "#94a3b8",
            "600": "#cbd5e1",
            "700": "#e2e8f0",
            "800": "#f1f5f9",
            "900": "#f8fafc"
        }
    },
    "typography": {
        "font_family": {
            "primary": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
            "secondary": "Georgia, serif",
            "monospace": "'JetBrains Mono', 'Fira Code', 'Courier New', monospace"
        },
        "font_sizes": {
            "xs": "0.75rem",
            "sm": "0.875rem",
            "base": "1rem",
            "lg": "1.125rem",
            "xl": "1.25rem",
            "2xl": "1.5rem",
            "3xl": "1.875rem",
            "4xl": "2.25rem"
        }
    },
    "color_variants": {
        "light_variants": [100, 200, 300, 400, 500],
        "dark_variants": [600, 700, 800, 900],
        "opacity_variants": [10, 20, 30, 40, 50, 60, 70, 80, 90]
    },
    "theme_config": {
        "enable_dynamic_themes": true,
        "auto_generate_variants": true,
        "css_variable_prefix": "--brand"
    },
    "platform": {
        "name": "Traderscore Quantum Terminal",
        "logo": {
            "type": "image",
            "src": "/barons-logo.jfif",
            "alt_text": "Traderscore Logo",
            "link_url": "/",
            "show_text": true,
            "text": "TRADERSCORE"
        },
        "footer": {
            "enable_language_settings": false,
            "enable_theme_toggle": true
        },
        "hostname": {
            "production": {
                "com": "baeonstrading-bot-template.vercel.app",
                "app": "baeonstrading-bot-template.vercel.app"
            },
            "staging": {
                "com": "baeonstrading-bot-template.vercel.app",
                "app": "baeonstrading-bot-template.vercel.app"
            }
        },
        "auth2_url": {
            "production": "https://auth.deriv.com/oauth2/",
            "staging": "https://staging-auth.deriv.com/oauth2/"
        },
        "derivws": {
            "url": {
                "staging": "https://staging-api.derivws.com/trading/v1/",
                "production": "https://api.derivws.com/trading/v1/"
            },
            "directories": {
                "options": "options/",
                "derivatives": "derivatives/"
            }
        }
    }
}
